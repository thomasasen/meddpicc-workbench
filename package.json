{
  "name": "meddpicc-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "schema:generate": "node scripts/generate-project-types.mjs",
    "dev": "npm run schema:generate && vite",
    "build": "npm run schema:generate && vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "npm run schema:generate && vitest run",
    "test:e2e": "npm run schema:generate && playwright test",
    "lint": "npm run schema:generate && eslint .",
    "format": "prettier --write \"src/**/*.{ts,vue}\" \"tests/**/*.ts\" \"scripts/**/*.mjs\" \"schema/**/*.json\" \"*.{ts,js,json}\" && prettier --write --parser json \"examples/*.meddpicc\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue}\" \"tests/**/*.ts\" \"scripts/**/*.mjs\" \"schema/**/*.json\" \"*.{ts,js,json}\" && prettier --check --parser json \"examples/*.meddpicc\"",
    "pages:sync": "npm run build && node scripts/sync-pages-root.mjs",
    "pages:check": "node scripts/sync-pages-root.mjs --check"
  },
  "dependencies": {
    "@lucide/vue": "1.51.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "pdf-lib": "1.17.1",
    "pinia": "4.0.3",
    "vue": "3.5.43",
    "vue-router": "5.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.56.1",
    "@vitejs/plugin-vue": "6.0.9",
    "eslint": "^9.39.1",
    "eslint-plugin-vue": "^10.5.1",
    "globals": "^16.4.0",
    "json-schema-to-typescript": "^15.0.4",
    "prettier": "^3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.46.2",
    "vite": "8.3.2",
    "vitest": "5.0.3",
    "vue-tsc": "3.3.12"
  }
}
